-- Credential table
CREATE TABLE IF NOT EXISTS credential_tbl (
    -- Unique ID
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,

    -- JSON data
    json_data TEXT NOT NULL CHECK(length(json_data) > 2 AND json_valid(json_data)),

    -- Credential struct version
    version INTEGER,

    -- Created date (unixtime in seconds)
    meta_created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    -- Updated date (unixtime in seconds)
    meta_updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')) CHECK(meta_updated_at >= meta_created_at)
) STRICT;

-- Triggers
CREATE TRIGGER IF NOT EXISTS credential_meta_updated_at_trig AFTER UPDATE ON credential_tbl
    BEGIN
        UPDATE credential_tbl SET meta_updated_at = strftime('%s', 'now') WHERE id = NEW.id;
    END;
